{
  "name": "mconf",
  "version": "2.0.0",
  "description": "Tiny environment-aware config loader for Node.js with deep-merge layering.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 95 --functions 95 --branches 90 node scripts/run-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run test:coverage && npm run build",
    "verify": "npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumeniukcom/mconf.git"
  },
  "keywords": [
    "configuration",
    "config",
    "environment",
    "env",
    "node-config",
    "deep-merge",
    "layered-config",
    "nodejs"
  ],
  "author": "Stanislav Gumeniuk <i@gumeniuk.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gumeniukcom/mconf/issues"
  },
  "homepage": "https://github.com/gumeniukcom/mconf#readme",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "c8": "^10.1.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.15.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
